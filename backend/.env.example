# DGen AI Backend Production Environment Variables

# Application Settings
ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security (Change in production!)
JWT_SECRET=your-dgen-ai-production-jwt-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# Set USE_MONGO_MOCK=false to connect to MongoDB Atlas Cloud
USE_MONGO_MOCK=false
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dgen_ai_prod

# CORS Settings (Allowed Frontend Domains)
CORS_ORIGINS=["https://dgen-ai.pages.dev","https://your-custom-domain.com","http://localhost:5173"]
