# FinSynth AI Environment Configuration

# Server Settings
APP_NAME="FinSynth AI"
ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
API_PREFIX="/api/v1"

# Security & JWT
JWT_SECRET="finsynth-ai-super-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="finsynth_ai"
USE_MONGO_MOCK=True

# Storage Paths
STORAGE_DIR="./storage"
DATASET_STORAGE_DIR="./storage/datasets"
MODEL_STORAGE_DIR="./storage/models"
EXPORT_STORAGE_DIR="./storage/exports"

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
